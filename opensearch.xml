<?xml version="1.0" encoding="UTF-8"?>
<!--
  OpenSearch description for Wispr Stories.
  Lets browsers add the site to their search bar so users can search
  inspiration examples (or, eventually, shared cards) without leaving the URL bar.

  Discovery is wired in wisprstories.html via:
    <link rel="search" type="application/opensearchdescription+xml"
          href="/opensearch.xml" title="Wispr Stories">
-->
<OpenSearchDescription xmlns="http://a9.com/-/spec/opensearch/1.1/">
  <ShortName>Wispr Stories</ShortName>
  <Description>Search inspiration examples in Wispr Stories — turn your voice into beautiful, shareable cards.</Description>
  <InputEncoding>UTF-8</InputEncoding>
  <Image width="16" height="16" type="image/png">https://wisprstories.vercel.app/assets/ws-logo-blwbg.png</Image>
  <Url type="text/html"
       method="get"
       template="https://wisprstories.vercel.app/?q={searchTerms}"/>
  <Url type="application/opensearchdescription+xml"
       rel="self"
       template="https://wisprstories.vercel.app/opensearch.xml"/>
  <moz:SearchForm xmlns:moz="http://www.mozilla.org/2006/browser/search/">https://wisprstories.vercel.app/</moz:SearchForm>
</OpenSearchDescription>
